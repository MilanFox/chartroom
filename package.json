{
  "name": "chartroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p cli/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@scalar/api-reference": "^1.76.4",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.3",
    "nuxt": "^4.3.0",
    "pinia": "^4.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/nuxt": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.97.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.2.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.13.0": true,
    "better-sqlite3@13.0.3": true
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  }
}
